# Public application URL. Production must be HTTPS and must not be localhost.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Production Supabase configuration. All three are required to select the
# production adapter. The service role is server-only and must NEVER use
# a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Long random server-only secret used to hash family access tokens.
MARSHALL_LINK_SECRET=

# SMS packet delivery stays queued-ready/preview-only until a provider adapter,
# credentials, and sender are intentionally configured. No provider is bundled.
MARSHALL_SMS_PROVIDER=
MARSHALL_SMS_API_KEY=
MARSHALL_SMS_SENDER=

# Required before production Permission-to-Embalm submission can be enabled.
MARSHALL_ESIGN_PROVIDER=
MARSHALL_ESIGN_API_KEY=

# Local walkthrough only. Production must set false.
MARSHALL_DEMO_MODE=false
# Local demo session/token configuration. Not used by Supabase Auth.
MARSHALL_SESSION_SECRET=
MARSHALL_DEV_STAFF_PASSWORD=
